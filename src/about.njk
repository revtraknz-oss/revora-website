---
layout: layouts/base.njk
title: About
description: "Northform RGM Advisory works with New Zealand FMCG suppliers on the commercial decisions that actually move margin: pricing, trade investment, portfolio strategy and customer terms."
permalink: /about/index.html
---

<section class="shell hero">
  <p class="eyebrow">{{ about.eyebrow }}</p>
  <h1 class="display" style="margin-top:26px; max-width:20ch;">{{ about.headline }}</h1>
  <p class="lede hero__lede">{{ about.lede }}</p>
</section>

<div class="creds">
  {% for c in about.credentials %}
  <div>
    <b class="figure">{{ c.figure }}</b>
    <span>{{ c.caption }}</span>
  </div>
  {% endfor %}
</div>

<section class="section">
  <div class="shell shell--narrow">
    <div class="prose mt-0">
      {{ about.body | markdown | safe }}
    </div>

    <div class="starthere" style="margin-top:56px;">
      <p class="eyebrow eyebrow--pine">Start here</p>
      <h2 class="h2" style="margin-top:18px;">{{ about.start.heading }}</h2>
      <p>{{ about.start.body }}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/contact/">Schedule an assessment</a>
        <a class="btn btn--ghost" href="/#practices">See where we find margin</a>
      </div>
    </div>
  </div>
</section>
