<!doctype html>
<html lang="en-NZ">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>{% if title %}{{ title }} | {{ site.name }}{% else %}{{ site.fullName }} | {{ site.tagline }}{% endif %}</title>
  <meta name="description" content="{{ description | default('Northform RGM Advisory helps New Zealand FMCG suppliers strengthen pricing strategy, optimise trade investment and build the commercial discipline that protects margin.') }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.fullName }}">
  <meta property="og:title" content="{% if title %}{{ title }} | {{ site.name }}{% else %}{{ site.fullName }}{% endif %}">
  <meta property="og:description" content="{{ description | default('Revenue growth management advisory for New Zealand FMCG suppliers.') }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta name="twitter:card" content="summary">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@300;400;500;600&display=swap">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/css/northform.css">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "{{ site.fullName }}",
    "description": "Revenue growth management advisory for New Zealand FMCG suppliers.",
    "url": "{{ site.url }}",
    "email": "{{ site.email }}",
    "telephone": "{{ site.phoneLink }}",
    "areaServed": { "@type": "Country", "name": "New Zealand" },
    "knowsAbout": ["Revenue growth management", "Pricing strategy", "Trade investment", "Portfolio and mix management", "Trade terms"]
  }
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  {% include "partials/header.njk" %}

  <main id="main">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}
</body>
</html>
