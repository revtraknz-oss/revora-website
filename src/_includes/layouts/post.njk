---
layout: layouts/base.njk
---
<article class="article">
  <div class="shell shell--narrow">
    <header class="article__head">
      <div class="article__meta">
        <b>{{ category }}</b>
        <time datetime="{{ date | isoDate }}">{{ date | displayDate }}</time>
      </div>
      <h1>{{ title }}</h1>
    </header>

    <div class="prose">
      {{ content | safe }}
    </div>
  </div>
</article>

<section class="section section--top">
  <div class="shell shell--narrow">
    <div class="starthere">
      <p class="eyebrow eyebrow--pine">Start here</p>
      <h2 class="h2" style="margin-top:18px;">Not sure where the margin opportunity sits? That&rsquo;s a normal place to start.</h2>
      <p>Most engagements begin with a short, no-cost conversation about what&rsquo;s happening in your numbers. If we don&rsquo;t think we can move them, we&rsquo;ll say so.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/contact/">Schedule an assessment</a>
        <a class="btn btn--ghost" href="/insights/">More insights</a>
      </div>
    </div>
  </div>
</section>
