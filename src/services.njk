---
layout: layouts/base.njk
title: What we do
description: "Northform's four practice areas for New Zealand FMCG suppliers: pricing strategy, trade investment, portfolio and mix management, and trade terms."
permalink: /services/
---

<section class="shell hero">
  <p class="eyebrow">{{ services.eyebrow }}</p>
  <h1 class="display" style="margin-top:26px; max-width:19ch;">{{ services.headline }}</h1>
  <p class="lede hero__lede">{{ services.lede }}</p>
</section>

<div class="shell">
  {% for p in services.practices %}
  <section class="practice-full" id="{{ p.anchor }}">
    <div class="practice-full__head">
      <p class="eyebrow">{{ "0" + (loop.index | string) }} &middot; {{ p.label }}</p>
      <h2 class="h2">{{ p.heading }}</h2>
      <p class="practice-full__intro">{{ p.intro }}</p>
      <div class="practice__prize">
        <b class="figure">{{ p.figure }}</b>
        <span>{{ p.figure_caption }}</span>
      </div>
    </div>

    <div class="practice-full__detail">
      <h3 class="detail-label">Questions we help answer</h3>
      <ul class="qlist">
        {% for q in p.questions %}
        <li>{{ q }}</li>
        {% endfor %}
      </ul>
      <div class="outcome">
        <span class="detail-label">What you walk away with</span>
        <p>{{ p.outcome }}</p>
      </div>
    </div>
  </section>
  {% endfor %}
</div>

<section class="section section--sunk section--top">
  <div class="shell">
    <div class="sec-head">
      <div>
        <p class="eyebrow">{{ services.closing.eyebrow }}</p>
        <h2 class="h2" style="margin-top:20px;">{{ services.closing.heading }}</h2>
      </div>
      <div class="sec-head__side">
        <p>{{ services.closing.body }}</p>
      </div>
    </div>
  </div>
</section>

<section class="section section--top">
  <div class="shell">
    <div class="starthere">
      <p class="eyebrow eyebrow--pine">Start here</p>
      <h2 class="h2" style="margin-top:18px;">{{ services.start.heading }}</h2>
      <p>{{ services.start.body }}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/contact/">Schedule an assessment</a>
        <a class="btn btn--ghost" href="tel:{{ site.phoneLink }}">{{ site.phone }}</a>
      </div>
    </div>
  </div>
</section>
