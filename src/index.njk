---
layout: layouts/base.njk
description: "Northform RGM Advisory helps New Zealand FMCG suppliers find the margin sitting inside their pricing, trade investment, portfolio mix and customer terms, then build the discipline that keeps it there."
---

<section class="shell hero hero--split">
  <div class="hero__copy">
    <p class="eyebrow">{{ home.hero.eyebrow }}</p>
    <h1 class="display" style="margin-top:26px;">{{ home.hero.headline | highlightFigure | safe }}</h1>
    <p class="lede hero__lede">{{ home.hero.lede }}</p>
    <div class="btn-row hero__actions">
      <a class="btn btn--primary" href="/contact/">Schedule an assessment</a>
      <a class="btn btn--ghost" href="/services/">See where we find margin</a>
    </div>
    <p class="hero__note">{{ home.hero.note }}</p>
  </div>
  {% if home.hero.image %}
  <figure class="hero__figure">
    <img src="{{ home.hero.image }}"
         {% if home.hero.image_small %}srcset="{{ home.hero.image_small }} 800w, {{ home.hero.image }} 1200w"
         sizes="(max-width: 900px) 100vw, 42vw"{% endif %}
         alt="{{ home.hero.image_alt }}" width="1200" height="1500" fetchpriority="high">
  </figure>
  {% endif %}
</section>

<div class="creds">
  {% for c in home.credentials %}
  <div>
    <b class="figure">{{ c.figure }}</b>
    <span>{{ c.caption }}</span>
  </div>
  {% endfor %}
</div>

<!-- ============================= MARGIN SQUEEZE ============================= -->
<section class="section" id="context">
  <div class="shell">
    <div class="sec-head">
      <div>
        <p class="eyebrow">{{ home.context.eyebrow }}</p>
        <h2 class="h2" style="margin-top:20px;">{{ home.context.heading }}</h2>
      </div>
      <div class="sec-head__side">
        <p>{{ home.context.intro }}</p>
      </div>
    </div>

    <div class="pressures">
      {% for p in home.context.pressures %}
      <div>
        <p class="eyebrow">Pressure {{ "0" + (loop.index | string) }}</p>
        <h3>{{ p.title }}</h3>
        <p>{{ p.body }}</p>
      </div>
      {% endfor %}
    </div>

    <p class="caveat" style="margin-top:40px;">{{ home.context.closing }}</p>
  </div>
</section>

<!-- ============================== PRACTICES =============================== -->
<section class="section section--sunk section--top" id="practices">
  <div class="shell">
    <div class="sec-head">
      <div>
        <p class="eyebrow">{{ home.practices.eyebrow }}</p>
        <h2 class="h2" style="margin-top:20px;">{{ home.practices.heading }}</h2>
      </div>
      <div class="sec-head__side">
        <p>{{ home.practices.intro }}</p>
      </div>
    </div>

    {% for item in home.practices.items %}
    <div class="practice">
      <div class="practice__label">
        <p class="eyebrow">{{ "0" + (loop.index | string) }} &middot; {{ item.label }}</p>
        <h3 class="h3"><a class="practice__link" href="/services/#{{ item.anchor }}">{{ item.heading }}</a></h3>
        <div class="practice__prize">
          <b class="figure">{{ item.figure }}</b>
          <span>{{ item.figure_caption }}</span>
        </div>
      </div>
      <div class="practice__body">
        <p class="problem">{{ item.problem }}</p>
        <p class="method">{{ item.method }}</p>
      </div>
    </div>
    {% endfor %}

    <p class="caveat">{{ home.practices.disclaimer }}</p>
  </div>
</section>

<!-- ============================== HOW WE WORK ============================== -->
<section class="section section--top" id="how">
  <div class="shell">
    <div class="sec-head">
      <div>
        <p class="eyebrow">{{ home.how.eyebrow }}</p>
        <h2 class="h2" style="margin-top:20px;">{{ home.how.heading }}</h2>
      </div>
      <div class="sec-head__side">
        <p>{{ home.how.intro }}</p>
      </div>
    </div>

    <div class="steps">
      {% for s in home.how.steps %}
      <div>
        <span class="num figure">Step {{ "0" + (loop.index | string) }}</span>
        <h3>{{ s.title }}</h3>
        <p>{{ s.body }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ============================= WHY NORTHFORM ============================= -->
<section class="section section--sunk section--top" id="why">
  <div class="shell">
    <div class="sec-head">
      <div>
        <p class="eyebrow">{{ home.why.eyebrow }}</p>
        <h2 class="h2" style="margin-top:20px;">{{ home.why.heading }}</h2>
      </div>
      <div class="sec-head__side">
        <p>{{ home.why.intro }}</p>
      </div>
    </div>

    <div class="pillars">
      {% for p in home.why.pillars %}
      <div>
        <h3>{{ p.title }}</h3>
        <p>{{ p.body }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ================================ INSIGHTS =============================== -->
<section class="section section--top" id="insights">
  <div class="shell">
    <div class="sec-head">
      <div>
        <p class="eyebrow">{{ home.insights.eyebrow }}</p>
        <h2 class="h2" style="margin-top:20px;">{{ home.insights.heading }}</h2>
      </div>
      <div class="sec-head__side">
        <p>{{ home.insights.intro }}</p>
      </div>
    </div>

    <div class="posts">
      {% for post in collections.posts | reverse %}
        {% if loop.index <= 3 %}
        <a class="post-row" href="{{ post.url }}">
          <div class="post-row__meta">
            <b>{{ post.data.category }}</b>
            <time datetime="{{ post.data.date | isoDate }}">{{ post.data.date | displayDate }}</time>
          </div>
          <div>
            <h3>{{ post.data.title }}</h3>
            <p>{{ post.data.excerpt }}</p>
          </div>
          <span class="post-row__arrow" aria-hidden="true">&rarr;</span>
        </a>
        {% endif %}
      {% endfor %}
    </div>

    <p style="margin-top:32px;"><a class="textlink" href="/insights/">All insights</a></p>
  </div>
</section>

<!-- =============================== START HERE ============================== -->
<section class="section section--top" id="start">
  <div class="shell">
    <div class="starthere">
      <p class="eyebrow eyebrow--pine">{{ home.start.eyebrow }}</p>
      <h2 class="h2" style="margin-top:18px;">{{ home.start.heading }}</h2>
      <p>{{ home.start.body }}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/contact/">{{ home.start.cta }}</a>
        <a class="btn btn--ghost" href="tel:{{ site.phoneLink }}">{{ site.phone }}</a>
      </div>
      <div class="contact-lines">
        <a href="mailto:{{ site.email }}">{{ site.email }}</a>
        <a href="tel:{{ site.phoneLink }}">{{ site.phone }}</a>
      </div>
    </div>
  </div>
</section>
