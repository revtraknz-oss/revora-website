<!DOCTYPE html>
<html lang="en-NZ">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} | {{ site.shortName }}{% else %}{{ site.name }} | Pricing, Trade & Portfolio Strategy{% endif %}</title>
  <meta name="description" content="{{ description or 'Revora is a specialist commercial advisory for New Zealand FMCG suppliers, focused on pricing, promotion, portfolio and trade decisions.' }}">
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script defer src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>

  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header{% if darkHeader %} site-header--dark{% endif %}" id="top">
    <div class="wrap header-inner">
      <a class="brand" href="/" aria-label="Revora home">
        <svg class="brand-mark" viewBox="0 0 34 26" aria-hidden="true" focusable="false">
          <rect x="0"  y="14" width="7" height="12" />
          <rect x="10" y="8"  width="7" height="18" />
          <rect x="20" y="14" width="7" height="6" class="brand-mark-mid" />
          <rect x="27" y="0"  width="7" height="26" class="brand-mark-accent" />
        </svg>
        <span class="brand-name">REVORA<span class="brand-sub">FMCG Advisory</span></span>
      </a>
      <nav class="site-nav" aria-label="Main">
        <button class="nav-toggle" aria-expanded="false" aria-controls="nav-menu">
          <span class="nav-toggle-bar"></span>
          <span class="visually-hidden">Menu</span>
        </button>
        <ul id="nav-menu" class="nav-menu">
          <li><a href="/about/"{% if page.url == '/about/' %} aria-current="page"{% endif %}>About</a></li>
          <li><a href="/services/"{% if page.url == '/services/' %} aria-current="page"{% endif %}>What we do</a></li>
          <li><a href="/insights/"{% if '/insights/' in page.url %} aria-current="page"{% endif %}>Insights</a></li>
          <li><a href="/contact/"{% if page.url == '/contact/' %} aria-current="page"{% endif %}>Contact</a></li>
          <li class="nav-cta"><a class="btn btn--small" href="/contact/">Book a conversation</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div class="footer-brand">
        <svg class="brand-mark brand-mark--footer" viewBox="0 0 34 26" aria-hidden="true" focusable="false">
          <rect x="0"  y="14" width="7" height="12" />
          <rect x="10" y="8"  width="7" height="18" />
          <rect x="20" y="14" width="7" height="6" class="brand-mark-mid" />
          <rect x="27" y="0"  width="7" height="26" class="brand-mark-accent" />
        </svg>
        <p class="footer-line">Specialist commercial advisory for New Zealand FMCG suppliers.</p>
      </div>
      <div class="footer-col">
        <p class="footer-heading">Revora</p>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/services/">What we do</a></li>
          <li><a href="/insights/">Insights</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <p class="footer-heading">Practice areas</p>
        <ul>
          <li><a href="/services/#pricing">Pricing &amp; pack architecture</a></li>
          <li><a href="/services/#promotions">Promotion &amp; investment</a></li>
          <li><a href="/services/#portfolio">Portfolio &amp; mix</a></li>
          <li><a href="/services/#trade">Trade terms &amp; architecture</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <p class="footer-heading">Get in touch</p>
        <ul>
          <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          <li><a href="tel:{{ site.phoneHref }}">{{ site.phone }}</a></li>
          <li>New Zealand</li>
        </ul>
      </div>
    </div>
    <div class="wrap footer-base">
      <p>&copy; {% year %} Revora FMCG Advisory. All rights reserved.</p>
    </div>
  </footer>

  <script src="/js/main.js"></script>
  <script>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", (user) => {
        if (!user) {
          window.netlifyIdentity.on("login", () => {
            document.location.href = "/admin/";
          });
        }
      });
    }
  </script>
</body>
</html>
